{
  "name": "football-schema",
  "version": "0.0.1",
  "description": "A canonical, machine-readable model of association football in JSON-LD: competitions, seasons, clubs, matches and league tables, with the Premier League as the reference competition.",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./model.js": "./tools/model.js",
    "./validate.js": "./tools/validate.js",
    "./context.jsonld": "./context.jsonld",
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "schema/",
    "context.jsonld",
    "tools/model.js",
    "tools/validate.js",
    "examples/",
    "class-diagram.svg",
    "docs/",
    "LICENSE"
  ],
  "scripts": {
    "diagram": "node tools/gen-class-diagram.js",
    "derive": "node tools/derive.js examples/*.jsonld",
    "test": "node tools/check.js",
    "og": "rsvg-convert -w 1200 -h 630 docs/og.svg -o og.png"
  },
  "homepage": "https://football-schema.github.io/schema/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/football-schema/schema.git"
  }
}
