classDiagram
  direction TB
  class Competition {
    +string name
    +code country
    +CompetitionFormat format
    +int? tier
    +gYear founded
    +int? clubsPerSeason
    +int? relegationPlaces
    +int? pointsForWin
    +int? pointsForDraw
    +matchesPerClub() derived
    +currentSeason() derived
  }
  class Season {
    +string label
    +date startDate
    +date endDate
    +Club[]? promoted
    +date? resultsAsOf
    +SeasonCoverage? coverage
    +champion() derived
  }
  class PointsDeduction {
    +Club club
    +int points
    +date? date
    +string? reason
  }
  class Club {
    +string name
    +string shortName
    +code tla
    +gYear founded
    +string? nickname
    +string[]? altNames
    +hexColour[]? colours
    +KitPattern? kitPattern
  }
  class Registration {
    +Player player
    +Season season
    +int shirtNumber
    +bool homegrown
  }
  class Stadium {
    +string name
    +string city
    +int? capacity
    +decimal? latitude
    +decimal? longitude
  }
  class Person {
    <<abstract>>
    +string name
    +string? knownAs
    +date dateOfBirth
    +code nationality
    +age() derived
  }
  class Player {
    +Position position
    +Foot preferredFoot
  }
  class Manager {
    +Club? club
  }
  class Referee {
    +bool fifaBadge
  }
  class TableZone {
    +int from
    +int to
    +ZoneKind kind
  }
  class Match {
    +dateTime kickoff
    +bool? timeConfirmed
    +int matchweek
    +MatchStatus status
    +int? attendance
    +Club homeTeam
    +Club awayTeam
    +Stadium venue
    +Referee? referee
    +homeScore() derived
    +awayScore() derived
    +result() derived
    +halfTimeScore() derived
  }
  class Lineup {
    +Club club
    +string formation
    +Manager manager
  }
  class Appearance {
    +Player player
    +int shirtNumber
    +bool starter
    +bool captain
    +minutesPlayed() derived
  }
  class MatchEvent {
    <<abstract>>
    +int minute
    +int? addedTime
    +Period period
    +Club club
    +clock() derived
  }
  class Goal {
    +Player scorer
    +Player? assist
    +GoalKind kind
    +creditedTo() derived
  }
  class Card {
    +Person player
    +CardColour colour
  }
  class Substitution {
    +Player playerOff
    +Player playerOn
    +bool concussion
  }
  class Score {
    +int home
    +int away
  }
  class Standing {
    +Club club
    +Season season
    +played() derived
    +won() derived
    +drawn() derived
    +lost() derived
    +goalsFor() derived
    +goalsAgainst() derived
    +goalDifference() derived
    +points() derived
    +deducted() derived
    +position() derived
    +form() derived
  }
  class Dataset {
    +string name
    +string publisher
    +iri? license
    +string[]? attribution
    +dateTime updated
    +string schemaVersion
    +Competition[]? competitions
    +Season[]? seasons
    +iri includes
  }
  class ForecastModel {
    +string name
    +string? modelVersion
    +string? method
  }
  class Rating {
    +Club club
    +ForecastModel model
    +decimal value
    +date asOf
    +int? rank
  }
  class MatchForecast {
    +Match fixture
    +ForecastModel model
    +dateTime issued
    +decimal homeWin
    +decimal draw
    +decimal awayWin
    +decimal? expectedHomeGoals
    +decimal? expectedAwayGoals
    +decimal? bothTeamsScore
    +logLoss() derived
    +rps() derived
  }
  class GoalLine {
    +decimal line
    +decimal over
  }
  class ScoreChance {
    +int home
    +int away
    +decimal chance
  }
  class SeasonProjection {
    +Club club
    +Season season
    +ForecastModel model
    +dateTime issued
    +decimal expectedPoints
    +decimal[] positions
    +string? scenario
    +championChance() derived
    +notFinishing() derived
    +zoneChance() derived
  }
  Competition "1" *-- "0..*" TableZone : zones
  Competition "1" *-- "1..*" Season : seasons
  Season --> "2..*" Club : clubs
  Season "1" *-- "0..*" Match : matches
  Season "1" *-- "0..*" PointsDeduction : deductions
  Season ..> "0..*" Standing : /table
  Club --> "1" Stadium : homeGround
  Club "1" *-- "0..*" Registration : squad
  Person <|-- Player
  Person <|-- Manager
  Person <|-- Referee
  Match "1" *-- "0..2" Lineup : lineups
  Match "1" *-- "0..*" MatchEvent : events
  Match "1" *-- "0..1" Score : fullTime
  Match "1" *-- "0..1" Score : halfTime
  Match "1" *-- "0..1" Score : currentScore
  Lineup "1" *-- "11..20" Appearance : appearances
  MatchEvent <|-- Goal
  MatchEvent <|-- Card
  MatchEvent <|-- Substitution
  MatchForecast "1" *-- "0..*" GoalLine : goalLines
  MatchForecast "1" *-- "0..*" ScoreChance : scores
