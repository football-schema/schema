{
  "@context": "../context.jsonld",
  "@graph": [
    {
      "@id": "fb:core",
      "@type": "Module",
      "label": "core",
      "version": "0.0.1",
      "comment": "The long-lived entities of football: competitions, seasons, clubs, grounds and people. A Competition is composed of Seasons; Clubs, Stadiums and People exist independently and are referenced, never owned.",
      "layer": "domain"
    },

    {
      "@id": "fb:Competition",
      "@type": "EntityClass",
      "module": "fb:core",
      "label": "Competition",
      "comment": "A league or cup that recurs season after season under one identity, e.g. the Premier League or the FA Cup.",
      "fields": [
        { "property": "fb:name", "label": "name", "valueType": "string", "comment": "Official name of the competition." },
        { "property": "fb:country", "label": "country", "valueType": "code", "comment": "ISO 3166 code of the governing association's country (GB-ENG for England)." },
        { "property": "fb:format", "label": "format", "enumType": "fb:CompetitionFormat", "comment": "League (round-robin) or knockout cup." },
        { "property": "fb:tier", "label": "tier", "valueType": "int", "optional": true, "comment": "Level in the national league pyramid; 1 is the top flight. Absent for cups." },
        { "property": "fb:founded", "label": "founded", "valueType": "gYear", "comment": "Year of the first season." },
        { "property": "fb:clubsPerSeason", "label": "clubsPerSeason", "valueType": "int", "optional": true, "comment": "Number of clubs in each season of a league (20 in the Premier League)." },
        { "property": "fb:relegationPlaces", "label": "relegationPlaces", "valueType": "int", "optional": true, "comment": "Clubs relegated at the end of each season." },
        { "property": "fb:pointsForWin", "label": "pointsForWin", "valueType": "int", "optional": true, "comment": "League points for a win (3 in English football since 1981)." },
        { "property": "fb:pointsForDraw", "label": "pointsForDraw", "valueType": "int", "optional": true, "comment": "League points for a draw." },
        { "property": "fb:zones", "label": "zones", "partType": "fb:TableZone", "multiplicity": "0..*", "comment": "Bands of table positions with a consequence: European qualification, relegation." },
        { "property": "fb:seasons", "label": "seasons", "partType": "fb:Season", "multiplicity": "1..*", "comment": "Every edition of the competition, oldest first. Embedded, or linked by IRI to a season file." }
      ],
      "derived": [
        { "property": "fb:matchesPerClub", "label": "matchesPerClub", "derivation": "2 * (clubsPerSeason - 1)", "comment": "Fixtures per club in a double round-robin: 38 for 20 clubs." },
        { "property": "fb:currentSeason", "label": "currentSeason", "derivation": "seasons.find(s => s.startDate <= today && today <= s.endDate)", "comment": "The season in progress today, if any." }
      ]
    },

    {
      "@id": "fb:Season",
      "@type": "EntityClass",
      "module": "fb:core",
      "label": "Season",
      "comment": "One edition of a competition, e.g. Premier League 2025/26. Owns its fixtures; references the clubs that take part.",
      "fields": [
        { "property": "fb:label", "label": "label", "valueType": "string", "comment": "Conventional name, e.g. \"2025/26\"." },
        { "property": "fb:startDate", "label": "startDate", "valueType": "date", "comment": "Date of the first scheduled match." },
        { "property": "fb:endDate", "label": "endDate", "valueType": "date", "comment": "Date of the last scheduled match." },
        { "property": "fb:clubs", "label": "clubs", "refType": "fb:Club", "multiplicity": "2..*", "comment": "Clubs entered in this season (20 in the Premier League)." },
        { "property": "fb:promoted", "label": "promoted", "refType": "fb:Club", "multiplicity": "0..*", "comment": "Clubs that joined from the division below for this season." },
        { "property": "fb:matches", "label": "matches", "partType": "fb:Match", "multiplicity": "0..*", "comment": "All fixtures of the season, played or not. Embedded, or linked by IRI to matchweek files." },
        { "property": "fb:resultsAsOf", "label": "resultsAsOf", "valueType": "date", "optional": true, "comment": "Date of the latest result included; later fixtures may have been played without their results being recorded yet." }
      ],
      "derived": [
        { "property": "fb:table", "label": "table", "itemType": "fb:Standing", "derivation": "classify(clubs.map(c => standing(c, matches)), rules)", "comment": "League table: one Standing per club, ordered by the competition's tie-break rules." },
        { "property": "fb:champion", "label": "champion", "derivation": "matches.every(m => m.status == 'finished') ? table[0].club : null", "comment": "Winner, once every fixture is complete." }
      ]
    },

    {
      "@id": "fb:Club",
      "@type": "EntityClass",
      "module": "fb:core",
      "label": "Club",
      "comment": "A football club. Exists independently of any competition; promotion and relegation move it between competitions.",
      "fields": [
        { "property": "fb:name", "label": "name", "valueType": "string", "comment": "Full name, e.g. \"Manchester City Football Club\"." },
        { "property": "fb:shortName", "label": "shortName", "valueType": "string", "comment": "Common short name, e.g. \"Man City\"." },
        { "property": "fb:tla", "label": "tla", "valueType": "code", "comment": "Three-letter abbreviation used in scorelines and graphics, e.g. MCI." },
        { "property": "fb:founded", "label": "founded", "valueType": "gYear", "comment": "Year of foundation." },
        { "property": "fb:nickname", "label": "nickname", "valueType": "string", "optional": true, "comment": "Traditional nickname, e.g. \"The Gunners\"." },
        { "property": "fb:colours", "label": "colours", "valueType": "hexColour[]", "optional": true, "comment": "Club colours as #rrggbb, most prominent first (normally the home shirt)." },
        { "property": "fb:kitPattern", "label": "kitPattern", "enumType": "fb:KitPattern", "optional": true, "comment": "Traditional pattern of the home shirt, used with colours to draw the club's shield." },
        { "property": "fb:homeGround", "label": "homeGround", "refType": "fb:Stadium", "multiplicity": "1", "comment": "The stadium where the club plays its home matches." },
        { "property": "fb:squad", "label": "squad", "partType": "fb:Registration", "multiplicity": "0..*", "comment": "Player registrations, one per player per season." }
      ]
    },

    {
      "@id": "fb:Registration",
      "@type": "EntityClass",
      "module": "fb:core",
      "label": "Registration",
      "comment": "A player's registration with a club for one season, carrying the squad number. Transfers end one registration and start another.",
      "fields": [
        { "property": "fb:player", "label": "player", "refType": "fb:Player", "multiplicity": "1", "comment": "The registered player." },
        { "property": "fb:season", "label": "season", "refType": "fb:Season", "multiplicity": "1", "comment": "The season the registration applies to." },
        { "property": "fb:shirtNumber", "label": "shirtNumber", "valueType": "int", "comment": "Squad number, 1–99, unique within the club for the season." },
        { "property": "fb:homegrown", "label": "homegrown", "valueType": "bool", "comment": "Registered with an English or Welsh club for three seasons before age 21." }
      ]
    },

    {
      "@id": "fb:Stadium",
      "@type": "EntityClass",
      "module": "fb:core",
      "label": "Stadium",
      "comment": "A ground where matches are played.",
      "fields": [
        { "property": "fb:name", "label": "name", "valueType": "string", "comment": "Current name of the ground." },
        { "property": "fb:city", "label": "city", "valueType": "string", "comment": "Town or city." },
        { "property": "fb:capacity", "label": "capacity", "valueType": "int", "optional": true, "comment": "All-seated capacity." },
        { "property": "fb:latitude", "label": "latitude", "valueType": "decimal", "optional": true, "comment": "WGS 84 latitude of the centre spot." },
        { "property": "fb:longitude", "label": "longitude", "valueType": "decimal", "optional": true, "comment": "WGS 84 longitude of the centre spot." }
      ]
    },

    {
      "@id": "fb:Person",
      "@type": "AbstractClass",
      "module": "fb:core",
      "label": "Person",
      "comment": "Anyone who takes part in a match in an official role. Never instantiated directly.",
      "fields": [
        { "property": "fb:name", "label": "name", "valueType": "string", "comment": "Full name." },
        { "property": "fb:knownAs", "label": "knownAs", "valueType": "string", "optional": true, "comment": "Name used on the shirt and in reports, if different." },
        { "property": "fb:dateOfBirth", "label": "dateOfBirth", "valueType": "date", "comment": "Date of birth." },
        { "property": "fb:nationality", "label": "nationality", "valueType": "code", "comment": "ISO 3166 code of the association the person represents (GB-ENG, GB-SCT, AR, …)." }
      ],
      "derived": [
        { "property": "fb:age", "label": "age", "derivation": "yearsBetween(dateOfBirth, today)", "comment": "Age in whole years today." }
      ]
    },

    {
      "@id": "fb:Player",
      "@type": "EntityClass",
      "module": "fb:core",
      "subClassOf": "fb:Person",
      "label": "Player",
      "comment": "A registered player.",
      "fields": [
        { "property": "fb:position", "label": "position", "enumType": "fb:Position", "comment": "Primary playing position." },
        { "property": "fb:preferredFoot", "label": "preferredFoot", "enumType": "fb:Foot", "comment": "Stronger foot." }
      ]
    },

    {
      "@id": "fb:Manager",
      "@type": "EntityClass",
      "module": "fb:core",
      "subClassOf": "fb:Person",
      "label": "Manager",
      "comment": "The head coach responsible for selecting a team.",
      "fields": [
        { "property": "fb:club", "label": "club", "refType": "fb:Club", "multiplicity": "0..1", "comment": "Club currently managed, if any." }
      ]
    },

    {
      "@id": "fb:Referee",
      "@type": "EntityClass",
      "module": "fb:core",
      "subClassOf": "fb:Person",
      "label": "Referee",
      "comment": "A match official on the Select Group list.",
      "fields": [
        { "property": "fb:fifaBadge", "label": "fifaBadge", "valueType": "bool", "comment": "Holds a FIFA international badge." }
      ]
    },

    {
      "@id": "fb:TableZone",
      "@type": "EntityClass",
      "module": "fb:core",
      "label": "TableZone",
      "comment": "A band of league positions with a consequence, e.g. 1st–4th: Champions League. Typical allocation only; cup winners and extra UEFA places can move it.",
      "fields": [
        { "property": "fb:from", "label": "from", "valueType": "int", "comment": "First position in the band." },
        { "property": "fb:to", "label": "to", "valueType": "int", "comment": "Last position in the band." },
        { "property": "fb:kind", "label": "kind", "enumType": "fb:ZoneKind", "comment": "What finishing in the band leads to." }
      ]
    },

    {
      "@id": "fb:ZoneKind",
      "@type": "Enumeration",
      "module": "fb:core",
      "label": "ZoneKind",
      "comment": "Consequence of finishing in a table zone.",
      "members": [
        { "name": "championsLeague", "comment": "UEFA Champions League league phase." },
        { "name": "europaLeague", "comment": "UEFA Europa League." },
        { "name": "conferenceLeague", "comment": "UEFA Conference League." },
        { "name": "relegation", "comment": "Relegation to the division below." }
      ]
    },

    {
      "@id": "fb:KitPattern",
      "@type": "Enumeration",
      "module": "fb:core",
      "label": "KitPattern",
      "comment": "Traditional home-shirt pattern.",
      "members": [
        { "name": "plain", "comment": "One body colour." },
        { "name": "stripes", "comment": "Vertical stripes in the first two colours." },
        { "name": "hoops", "comment": "Horizontal hoops in the first two colours." },
        { "name": "sleeves", "comment": "Body in the first colour, sleeves in the second." },
        { "name": "halves", "comment": "Left and right halves in the first two colours." }
      ]
    },

    {
      "@id": "fb:CompetitionFormat",
      "@type": "Enumeration",
      "module": "fb:core",
      "label": "CompetitionFormat",
      "comment": "How a competition decides its winner.",
      "members": [
        { "name": "league", "comment": "Round-robin; ranked by points in a table." },
        { "name": "knockout", "comment": "Single-elimination ties; replays, extra time or penalties decide draws." }
      ]
    },

    {
      "@id": "fb:Position",
      "@type": "Enumeration",
      "module": "fb:core",
      "label": "Position",
      "comment": "Broad playing position, as used in squad lists.",
      "members": [
        { "name": "GK", "comment": "Goalkeeper." },
        { "name": "DF", "comment": "Defender." },
        { "name": "MF", "comment": "Midfielder." },
        { "name": "FW", "comment": "Forward." }
      ]
    },

    {
      "@id": "fb:Foot",
      "@type": "Enumeration",
      "module": "fb:core",
      "label": "Foot",
      "comment": "Preferred kicking foot.",
      "members": [
        { "name": "left", "comment": "Left-footed." },
        { "name": "right", "comment": "Right-footed." },
        { "name": "both", "comment": "Two-footed." }
      ]
    }
  ]
}
